# Optional overrides. The defaults work out of the box for local development.
# Export these in your shell (or use your process manager); Django does not load this file itself.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

// Layout shared by the sign-in and registration pages.
// Each page pulls it in with `@use '../auth-form';` so the two stay identical.

:host {
  display: block;
}

.auth-container {
  width: 100%;
  max-width: 24rem;
  margin: 1.5rem auto 0;
  padding: 1.5rem;
  border: 1px solid #d9d6cc;
  border-radius: 0.5rem;
  background: #fff;
}

h2 {
  margin: 0 0 1.25rem;
  font-size: 1.375rem;
  line-height: 1.25;
}

.error-alert {
  margin-bottom: 1rem;
  padding: 0.625rem 0.75rem;
  border: 1px solid var(--color-error);
  border-left-width: 4px;
  border-radius: 0.375rem;
  background: #fbeae8;
  color: #7a2119;
  font-size: 0.9375rem;
}

form {
  display: grid;
  gap: 1rem;
}

.form-group {
  display: grid;
  gap: 0.375rem;
}

label {
  font-size: 0.9375rem;
  font-weight: 500;
}

input {
  width: 100%;
  min-height: 2.5rem;
  padding: 0.375rem 0.75rem;
  border: 1px solid #b9b4a8;
  border-radius: 0.375rem;
  background: #fff;
  color: inherit;
  font: inherit;

  &::placeholder {
    color: var(--color-muted);
  }

  &:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
}

button[type='submit'] {
  min-height: 2.5rem;
  padding: 0.375rem 1rem;
  border: 1px solid var(--color-ink);
  border-radius: 0.375rem;
  background: var(--color-ink);
  color: var(--color-paper);
  font: inherit;
  font-weight: 600;
  cursor: pointer;

  &:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  &:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
}

p {
  margin: 1.25rem 0 0;
  color: var(--color-muted);
  font-size: 0.9375rem;
}

a {
  color: var(--color-focus);
}